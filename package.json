{
  "name": "playarr-tv",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --clean",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint",
    "postinstall": "node -e \"require('fs').rmSync('node_modules/react-native/node_modules/react-native',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/archivo-black": "^0.4.1",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "buffer": "^6.0.3",
    "expo": "~57.0.13",
    "expo-font": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86-stable",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-svg": "15.15.4",
    "react-native-tcp-socket": "^6.4.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.6",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "main": "index.js",
  "overrides": {
    "react-native": "$react-native"
  }
}
